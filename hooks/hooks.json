{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/agent_events.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/scripts/agent_events.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/agent_events.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/scripts/agent_events.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(infracortex:)?(terraform-engineer|k8s-troubleshooter|docker-engineer|finops-analyst|cortex|overseer)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/agent_events.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/scripts/agent_events.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(infracortex:)?(terraform-engineer|k8s-troubleshooter|docker-engineer|finops-analyst|cortex|overseer)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/contract_gate.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/scripts/contract_gate.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/agent_events.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/scripts/agent_events.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
